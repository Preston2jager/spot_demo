# Copy this file to .env and fill in the values.

# ── Map ───────────────────────────────────────────────────────────────────────
SPOT_MAP_DIR=./runtime/maps/amp_3

# ── Robot connection ──────────────────────────────────────────────────────────
# Optional. credentials.json is the ordinary way to say this; these override it, which is
# how the demo_web container runs — it has no credentials file, and Spot answers on
# 192.168.50.3 from inside the CoreIO rather than on 192.168.80.3.
SPOT_HOSTNAME=
SPOT_USERNAME=
SPOT_PASSWORD=

# ── Web console ───────────────────────────────────────────────────────────────
# `python start.py` serves the console — cameras, AI layer, map, missions, Stop, log — on WEB_PORT.
WEB_PORT=8080

# Camera frame rate, and how often the AI preview rescans the surround cameras while AI is on.
WEB_CAPTURE_FPS=10
WEB_SCAN_INTERVAL=2.0

# ── Mission waypoints ─────────────────────────────────────────────────────────
# Seeds the home point only. The pick point, the three bins and the patrol are chosen on
# the control page's map and saved to runtime/web_selection.json.
GO_HOME_WAYPOINT=waypoint_59

# ── Sorting demo ──────────────────────────────────────────────────────────────
# Gripper torque (N·m) once an object is held, by the grip material the vision service
# reports. Tune on the real objects.
GRIP_TORQUE_SOFT=1.5
GRIP_TORQUE_MEDIUM=4.0
GRIP_TORQUE_HARD=8.0
# Where the arm releases over a bin, in the body frame (metres ahead, metres up).
SORT_BIN_DROP_X=0.85
SORT_BIN_DROP_Z=0.15
# The approach servo: final object distance from the body centre, tolerances, the first
# walk's standoff, and the re-check period.
SORT_GRASP_RANGE_M=0.85
SORT_RANGE_TOL_M=0.10
SORT_YAW_TOL_DEG=7
SORT_STANDOFF_M=1.25
SORT_SERVO_PERIOD=0.5
SORT_SERVO_TIMEOUT=25

# ── Object registry ───────────────────────────────────────────────────────────
# Detections from every scan are merged into objects in space; one seen in TRACK_MIN_SCANS
# scans within TRACK_RADIUS_M is registered and can be chosen. A grasp mission surveys with
# SURVEY_SCANS scans before choosing. Unseen objects are forgotten after TRACK_TTL_SEC.
TRACK_RADIUS_M=0.25
TRACK_MIN_SCANS=2
TRACK_TTL_SEC=120
# One sighting classified at least this confidently registers an object on its own, and a
# survey also offers what was seen this many seconds before it started.
TRACK_SURE_CONF=0.5
TRACK_RECENT_SEC=30
SURVEY_SCANS=3
# A survey scans the hand camera and every body camera (1) or only the front pair (0) — the
# console's Surround vision switch starts here. Front only, an object counts as ahead within
# VISION_FRONT_HALF_DEG of straight ahead.
VISION_SURROUND=1
VISION_FRONT_HALF_DEG=60
# Every action starts with the hand straight ahead and the gripper open (the teleop pose);
# a positive pitch tips the hand camera down to see the floor just ahead.
ARM_READY_PITCH_DEG=0

# ── Grasp here (no map) ───────────────────────────────────────────────────────
# Only objects within this distance of the body are offered or taken.
GRAB_REACH_M=2.0
# Where the arm sets the object down, in the gravity-aligned body frame (metres ahead, metres
# relative to the body centre — negative is below it, ~0.5 m above the floor when standing).
SET_DOWN_X=0.80
SET_DOWN_Z=-0.25

# ── CoreIO speaker ────────────────────────────────────────────────────────────
COREIO_HOST=192.168.80.3
COREIO_PORT=20022
COREIO_USER=spot
COREIO_PASSWORD=

# Dockge's UI (CoreIO port 5001) forwarded to this laptop by start.py — the same as
# `ssh -p 20022 -L 5001:127.0.0.1:5001 spot@<COREIO_HOST>`. 0 turns it off.
DOCKGE_LOCAL_PORT=8081
DOCKGE_REMOTE_PORT=5001

# ALSA playback device on the CoreIO; CARD=<name> survives USB card indexes shifting.
COREIO_AUDIO_DEVICE=plughw:CARD=Device,DEV=0

# Playback volume, 0-100 (percent of the sound card's own range).
# The USB dongle only attenuates — 100 is its 0.00dB ceiling, so this only turns it down.
# Leave blank to keep whatever level the CoreIO's mixer is already set to.
COREIO_SPEAKER_VOLUME=100

# Announced by Initialisation before Spot sits down (relative to the project root).
RESET_ANNOUNCE_AUDIO=assets/audio/init.mp3

# ── CoreIO RealSense ──────────────────────────────────────────────────────────
# The depth camera on the CoreIO, reached exactly like the YOLO service: an SSH channel
# to a port bound on CoreIO-localhost. Deploy the bridge with
# `python coreio/deploy_realsense.py`; it reads realsense2_camera's topics rather than
# opening the device, which is already held by the realsense_ros2 container.
#
# Set COREIO_RS_ENABLED=0 on a robot with no RealSense fitted — the console then simply
# does not offer the Depth Camera tab.
COREIO_RS_ENABLED=1
COREIO_RS_PORT=8782
COREIO_RS_TIMEOUT=8
# 1 only when the console itself runs on the CoreIO (the demo_web container): the bridge
# is then a localhost port, and tunnelling into the machine you are on buys nothing.
COREIO_RS_DIRECT=0

# ── The map tab ───────────────────────────────────────────────────────────────
# The console draws the robot's own GraphNav map in 3D, using the point clouds stored in
# its waypoint snapshots. Both settings below are part of the cache key, so changing one
# rebuilds rather than serving the old cloud.
#
# Points further than this from the camera that saw them are dropped. Spot's clouds come
# from stereo depth, whose error grows with the square of range — past 8 m a return is
# mostly a guess, and a map's worth of guesses hides the room.
WEB_CLOUD_RANGE_M=8.0
# Upper bound on points kept, thinned by a stride. Only bites on maps much larger than
# the 56-waypoint one here, which comes to about half a million.
WEB_CLOUD_POINTS=400000

# ── CoreIO vision ─────────────────────────────────────────────────────────────
# The segment + classify service, the `spot-vision` Dockge stack. Bake and deploy with
# coreio/vision/bake_vocab.py and coreio/deploy_vision.py. Reached over the COREIO_* SSH
# session above; 8783 belongs to the live-cloud stitcher, so vision is on 8784.
COREIO_VISION_PORT=8784
COREIO_VISION_TIMEOUT=12
COREIO_VISION_RETRY_SEC=15
COREIO_VISION_JPEG_QUALITY=85
# 1 only when the console itself runs on the CoreIO (the demo_web container).
COREIO_VISION_DIRECT=0
# Objects closer than this to a body camera are Spot's own legs, and are dropped.
VISION_SELF_RANGE_M=0.40

# ── 3D Recon (fused on this laptop, not the robot) ────────────────────────────
# Voxel size, how far each sensor is trusted, and how many frames must see a voxel before
# it is drawn. Smaller voxels are finer and noisier; more hits is cleaner and slower to fill.
RECON_VOXEL_M=0.01
RECON_FAR_M=3.0
RECON_FAR_BODY_M=2.5
# The left, right and back cameras fill in all round: trusted to a shorter range, weighted
# below the front (so the front decides where they overlap), captured every this many seconds.
RECON_FAR_SIDE_M=2.0
RECON_SIDE_WEIGHT=0.25
RECON_SIDE_PERIOD=1.0
RECON_MIN_HITS=2
# Seen through, and not hit, for this many seconds → removed (someone who walked away). 0 = off.
RECON_CARVE_SEC=2.0
# The RealSense's pose on the body: x,y,z (metres, body frame: x forward, y left, z up) and
# roll,pitch,yaw (degrees; 0,0,0 looks straight ahead; pitch positive looks down), for the
# picture as the bridge serves it (already turned upright). Measure it on the robot.
RECON_RS_MOUNT=0.30,0,0.10,0,15,0
