# Copy this file to .env and fill in the values.

# ── Map ───────────────────────────────────────────────────────────────────────
SPOT_MAP_DIR=./runtime/maps/amp_3

# ── Mission waypoints ─────────────────────────────────────────────────────────
GO_HOME_WAYPOINT=waypoint_59

# Guard loop (continuous patrol + grasp)
GUARD_POINT=waypoint_67
GUARD_POINT_ALT=waypoint_22
HOME_POINT=default

# Guard first (single run with initial patrol route)
GUARD_FIRST_POINT=waypoint_89
GUARD_FIRST_HOME=default
GUARD_FIRST_ROUTE=waypoint_122,waypoint_124,waypoint_122
GUARD_FIRST_STANDBY=waypoint_40

# Patrol only
PATROL_ROUTE=waypoint_175,default

# ── MCP / bot services ────────────────────────────────────────────────────────
MCP_SERVER_URL=http://localhost:8000/sse
TEAMS_PORT=3978

MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=
TELEGRAM_BOT_TOKEN=
WHISPER_MODEL=base
