# Environment for the demo_web container. `coreio/deploy_web.py` writes the real
# demo_web.env from the laptop's .env and credentials.json and uploads it mode 600;
# this file is the committed template, and the place to read what each line is for.
#
# Everything here is written from the CoreIO's point of view, which is the part that
# catches people out: the robot, the detector and the speaker all have different
# addresses from inside the robot than from the laptop.

# ── Spot's API ────────────────────────────────────────────────────────────────
# 192.168.50.3 is Spot from the CoreIO — the payload network. 192.168.80.3 is Spot from
# *your laptop*, and putting that here reaches nothing.
SPOT_HOSTNAME=192.168.50.3
SPOT_USERNAME=
SPOT_PASSWORD=

# ── The console ───────────────────────────────────────────────────────────────
# The container runs on the host network, so these are the CoreIO's own ports: the
# display page for the room, and the control page for the operator.
WEB_PORT=8080
WEB_CONTROL_PORT=8081

# ── Vision ────────────────────────────────────────────────────────────────────
# The spot-vision stack. COREIO_VISION_DIRECT=1 turns the SSH tunnel off: the service is
# a localhost port to a container already on the CoreIO.
COREIO_VISION_DIRECT=1
COREIO_VISION_HOST=127.0.0.1
COREIO_VISION_PORT=8784
COREIO_VISION_TIMEOUT=12

# The RealSense bridge is another container on this host network, so it is dialled
# directly for the same reason the detector is.
COREIO_RS_ENABLED=1
COREIO_RS_DIRECT=1
COREIO_RS_HOST=127.0.0.1
COREIO_RS_PORT=8782

# The camera frame rate, and how often the AI preview rescans while it is switched on.
WEB_CAPTURE_FPS=10
WEB_SCAN_INTERVAL=2.0

# ── Speaker ───────────────────────────────────────────────────────────────────
# Still over SSH, and still to 127.0.0.1: playback needs `aplay` on the CoreIO *host*,
# which this container cannot call directly.
# Port 22, not 20022: 20022 is Spot's forward of this sshd, reachable from a laptop on
# the robot's wifi. From inside the CoreIO the daemon is on its own port 22.
COREIO_HOST=127.0.0.1
COREIO_PORT=22
COREIO_USER=spot
COREIO_PASSWORD=
COREIO_AUDIO_DEVICE=plughw:CARD=Device,DEV=0
COREIO_SPEAKER_VOLUME=100
RESET_ANNOUNCE_AUDIO=assets/audio/init.mp3

# ── Map ───────────────────────────────────────────────────────────────────────
SPOT_MAP_DIR=/app/runtime/maps/amp_3
GO_HOME_WAYPOINT=waypoint_59
